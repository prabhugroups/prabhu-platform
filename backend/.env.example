APP_NAME=Prabhu Platform API
ENVIRONMENT=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prabhu_platform
DB_USER=prabhu_platform
DB_PASSWORD=change-me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256

UPLOADS_DIR=./uploads

# Subdomain tenant routing: <tenant-slug>.TENANT_BASE_DOMAIN resolves to that
# tenant when no tenant_domains row matches. For local dev, `localhost` makes
# http://<slug>.localhost:3000 work with no /etc/hosts edits. Empty disables.
TENANT_BASE_DOMAIN=localhost

# Tenants created by `python -m app.db.seed`: a preset from
# app/db/seed_data/tenant_presets/ (prabhu = the 7 Prabhu Group sites), or empty.
SEED_TENANTS=prabhu

# Set true only behind Traefik (docker-compose sets it) — see app/core/config.py.
BEHIND_PROXY=false
