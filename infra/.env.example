# Copy to .env and fill in real values. Never commit the real .env.

# --- Traefik / TLS ---
ACME_EMAIL=ops@example.com
# Real DNS record required at deploy time — see docs/RUNBOOK.md. Must NOT be
# one of the 7 tenant domains.
SUPER_ADMIN_DOMAIN=platform-admin.example.com

# --- MySQL ---
DB_NAME=prabhu_platform
DB_USER=prabhu_platform
DB_PASSWORD=change-me-generate-a-real-password
DB_ROOT_PASSWORD=change-me-generate-a-real-root-password

# --- Backend ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-real-secret

# --- Initial Super Admin (seeded once on first boot; safe to unset afterwards) ---
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-generate-a-real-password
