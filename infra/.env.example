# Production configuration for the Docker stack (docker-compose.yml).
# Copy to infra/.env and fill in real values. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32

# =============================================================================
# Domains & routing
# =============================================================================
# Every tenant is served at https://<tenant-slug>.BASE_DOMAIN — e.g. with
# BASE_DOMAIN=example.com, tenant "prabhusteels" is prabhusteels.example.com.
# DNS: point BASE_DOMAIN's wildcard record (*.example.com) at this server.
# A different subdomain for a tenant (a.example.com -> tenant "alpha") is a
# tenant_domains row added from the Super Admin console; no change here.
BASE_DOMAIN=example.com

# Operator-only Super Admin console. Must not be a tenant slug's subdomain.
# /super-admin is only routed on this host, never on tenant hosts.
SUPER_ADMIN_DOMAIN=admin.example.com

# Optional: extra full hostnames served by the platform (e.g. a tenant's own
# domain), comma-separated. Each must also be a tenant_domains row for the
# tenant it belongs to, and have DNS pointing at this server.
# CUSTOM_DOMAINS=prabhusteel.com,www.prabhusteel.com
CUSTOM_DOMAINS=

# =============================================================================
# TLS (Let's Encrypt via Traefik)
# =============================================================================
#   dns        (recommended) one wildcard cert for *.BASE_DOMAIN via DNS-01.
#              New tenants work with zero infra changes. Needs DNS API creds.
#   http       one cert per host via HTTP-01. No DNS creds, but wildcards are
#              impossible, so every tenant subdomain must be in TENANT_SUBDOMAINS.
#   selfsigned Traefik's default self-signed cert — local/staging testing only.
TLS_CHALLENGE=dns
ACME_EMAIL=ops@example.com

# Uncomment to use Let's Encrypt staging while testing (untrusted certs, but
# no production rate limits). Wipe the traefik_acme volume when switching back.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# TLS_CHALLENGE=dns: DNS provider (lego name) and its API credentials.
# Cloudflare token needs Zone:Read + DNS:Edit on BASE_DOMAIN's zone.
ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=

# TLS_CHALLENGE=http only: tenant subdomains to issue certs for (comma-separated).
# TENANT_SUBDOMAINS=prabhusteels,hydro-holdings,prabhu-holdings
TENANT_SUBDOMAINS=

# =============================================================================
# MySQL
# =============================================================================
DB_NAME=prabhu_platform
DB_USER=prabhu_platform
DB_PASSWORD=change-me-generate-a-real-password
DB_ROOT_PASSWORD=change-me-generate-a-real-root-password

# =============================================================================
# Backend
# =============================================================================
# Signs admin session JWTs. The API refuses to start with a placeholder.
JWT_SECRET=change-me-generate-a-real-secret
# Keep at 1 unless you accept per-worker (looser) in-memory rate limits.
BACKEND_WORKERS=1

# =============================================================================
# Initial Super Admin — created on first deploy only; safe to blank afterwards.
# =============================================================================
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-generate-a-real-password

# =============================================================================
# Images (built and pushed to GHCR by CI)
# =============================================================================
# Git commit SHA of the release to run. The CI deploy job rewrites this line
# on every successful deploy; set it by hand only to roll back (see
# infra/.deploy-history for previously deployed tags).
IMAGE_TAG=latest
# IMAGE_REGISTRY=ghcr.io/prabhugroups
